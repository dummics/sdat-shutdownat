<Window
    x:Class="Sdat.App.QuickPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="PaletteRoot"
        Padding="12"
        CornerRadius="14"
        Background="Transparent"
        BorderThickness="0"
        Loaded="OnPaletteLoaded"
        PreviewKeyDown="OnKeyDown">
        <Grid x:Name="PaletteLayout">
            <Border
                x:Name="FeedbackPanel"
                MaxWidth="570"
                MaxHeight="44"
                Padding="10,5"
                HorizontalAlignment="Center"
                CornerRadius="7"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                Opacity="0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FeedbackTransform" />
                </Border.RenderTransform>
                <TextBlock
                    x:Name="FeedbackText"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <Grid
                x:Name="CommandPanel"
                ColumnSpacing="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ActionPicker" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem x:Uid="ShutdownAction" Content="Shut down" Tag="Shutdown" />
                    <ComboBoxItem x:Uid="SuspendAction" Content="Suspend" Tag="Suspend" />
                    <ComboBoxItem x:Uid="RestartAction" Content="Restart" Tag="Restart" />
                </ComboBox>
                <Border
                    Grid.Column="1"
                    x:Name="TimeInputFrame"
                    Height="33"
                    CornerRadius="4"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <TextBox
                        x:Name="TimeInput"
                        x:Uid="TimeInput"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,4,10,5"
                        PlaceholderText="36m or 23:41"
                        TextChanged="OnTimeInputChanged"
                        GotFocus="OnTimeInputGotFocus"
                        LostFocus="OnTimeInputLostFocus"
                        VerticalAlignment="Center" />
                </Border>
                <Button
                    Grid.Column="2"
                    x:Name="ScheduleButton"
                    x:Uid="ScheduleButton"
                    Content="Schedule"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnSchedule"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="3"
                    x:Name="PaletteCancelButton"
                    Content="Cancel schedule"
                    Visibility="Collapsed"
                    Click="OnCancelSchedule"
                    VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
